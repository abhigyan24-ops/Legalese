# Firebase Configuration - Rights Quest
# Copy this file to .env and replace placeholder values with your actual Firebase project credentials
# Get these values from: Firebase Console → Project Settings → General → Your apps → SDK setup and configuration

# Firebase API Key - Used for client SDK authentication
VITE_FIREBASE_API_KEY=your-api-key-here

# Firebase Auth Domain - Used for authentication redirects
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID - Your Firebase project identifier
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket - Cloud Storage bucket name
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID - Used for Firebase Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID - Your Firebase app identifier
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# IMPORTANT: Never commit the actual .env file to version control!
# The .env file should be listed in .gitignore
